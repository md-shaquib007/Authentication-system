NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mern-auth-db

ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=12h

REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d

# Brevo (https://www.brevo.com) — free tier: 300 emails/day
BREVO_API_KEY=xkeysib-your_brevo_api_key
SENDER_EMAIL=your-verified-email@gmail.com
SENDER_NAME=MERN Auth

# Comma-separated for multiple origins (local + production)
CLIENT_URL=http://localhost:5173

# Optional: Redis for shared rate limiting across serverless instances (e.g. Upstash)
# REDIS_URL=redis://default:password@host:6379

# Optional: override API URL in frontend dev mode
# VITE_API_URL=http://localhost:5000/api/auth
